# Runtime configuration for local development.
#
# Deliberately left empty. NEXT_PUBLIC_* values are inlined into the client
# bundle at build time, so anything set here ships to every user of every build
# made from this repository, including self-hosted ones. Set your own values in
# .env.local, which is gitignored, or through the environment at run time.

# Google Analytics measurement ID.
# GA_ID is read at run time by /api/ga-config, so it can be set per deployment
# without a rebuild. Prefer it over NEXT_PUBLIC_GA_ID, which is baked in at
# build time and then cannot be overridden at run time.
GA_ID=
NEXT_PUBLIC_GA_ID=
