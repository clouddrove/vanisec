{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": { "@lib/*": ["../lib/*"], "@/*": ["../*"] }
  },
  "include": ["src/**/*", "test/**/*", "tsup.config.ts"]
}
